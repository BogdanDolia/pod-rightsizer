{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Catalog of invariants that JSON Schema does not execute. executedBy is none unless a named Go test actually runs that statement. Naming a test is not proof of a different statement.",
  "title": "SemanticCheckCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "checks"],
  "properties": {
    "schemaVersion": { "$ref": "defs.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "SemanticCheckCatalog" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "executedBy", "statement", "example"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "owner": {
            "type": "string",
            "pattern": "^T(0[3-9](\\.1)?|1[0-6])$"
          },
          "executedBy": {
            "description": "none means the check is not wired. go-test names the test that executes this statement.",
            "type": "string",
            "pattern": "^(none|go-test:[A-Za-z0-9_./]+)$"
          },
          "statement": { "type": "string", "minLength": 1 },
          "example": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
