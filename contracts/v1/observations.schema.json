{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Identity and metric evidence for one run. Source timestamps are not poll times. Overlapping windows stay in windows[] with disposition discarded; they are not new independent observations. discovery not_obtained stores no UID, digest, or pod. discovery partial stores the Deployment identity that was read and records the pod census separately. executed false stores no load measurements.",
  "title": "Observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "dataClass",
    "runId",
    "workload",
    "identityStable",
    "ownerChain",
    "pods",
    "serviceMapping",
    "autoscaler",
    "load",
    "windows",
    "coverage"
  ],
  "properties": {
    "schemaVersion": { "$ref": "defs.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "Observations" },
    "dataClass": { "$ref": "defs.schema.json#/$defs/dataClass" },
    "runId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "workload": {
      "description": "read is a completed discovery: Deployment identity, a non-empty owner chain, and at least one pod. partial is a successful Deployment read whose pod census is empty or was not returned. not_obtained is an early failure or cancellation before that Deployment read, including a client timeout, a transport error, and an API server 5xx. partial keeps the UID, generation, and a digest only when one was read. not_obtained stores none of those. Neither partial nor not_obtained stores a pod UID, an owner UID, or a stability confirmation.",
      "oneOf": [
        { "$ref": "#/$defs/workloadRead" },
        { "$ref": "#/$defs/workloadPartial" },
        { "$ref": "#/$defs/workloadUnread" }
      ]
    },
    "identityStable": {
      "description": "True only when discovery is read and UID, generation, image, container restart, and replica count are all unchanged. False when any of those changed. Also false when discovery is not_obtained or partial: stability was not established. That false value is not a claim that the identity changed, and it is not by itself the evidence axis.",
      "type": "boolean"
    },
    "ownerChain": {
      "description": "ReplicaSet owners of the measured pods. Non-empty only for discovery read. Empty on not_obtained and partial. On partial, empty is not a ReplicaSet census and is not a claim that no ReplicaSet exists.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "uid"],
        "properties": {
          "kind": { "const": "ReplicaSet" },
          "name": { "type": "string", "minLength": 1 },
          "uid": { "$ref": "defs.schema.json#/$defs/uuid" }
        }
      }
    },
    "pods": {
      "description": "Measured pods. Non-empty only for discovery read. Empty on not_obtained and partial. On partial, workload.podList.discovery says whether the empty array is a successful census or a list that was not returned.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uid", "ownerUid", "containerId", "imageDigest", "restartCount", "nodeName", "nodeClass"],
        "properties": {
          "name": { "$ref": "defs.schema.json#/$defs/k8sSubdomain" },
          "uid": { "$ref": "defs.schema.json#/$defs/uuid" },
          "ownerUid": { "$ref": "defs.schema.json#/$defs/uuid" },
          "containerId": {
            "description": "Runtime container id. Not a registry credential.",
            "type": "string",
            "pattern": "^[a-z0-9]+://[^\\s]+$"
          },
          "imageDigest": { "$ref": "defs.schema.json#/$defs/imageDigest" },
          "restartCount": { "type": "integer", "minimum": 0 },
          "nodeName": { "type": "string", "minLength": 1 },
          "nodeClass": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "name"],
                "properties": {
                  "state": { "const": "known" },
                  "name": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["state"],
                "properties": { "state": { "const": "unknown" } }
              }
            ]
          }
        }
      }
    },
    "serviceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "routeProof"],
      "properties": {
        "status": { "$ref": "defs.schema.json#/$defs/targetState" },
        "serviceName": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "routeProof": {
          "description": "endpoint_slice verifies a Service route only. It does not verify direct_pod. declared_only and none stay unverified. A direct_pod experiment uses experiment.observed.proofMethod direct_pod and does not require serviceName.",
          "enum": ["endpoint_slice", "declared_only", "none"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          },
          "then": { "properties": { "routeProof": { "const": "endpoint_slice" } } }
        },
        {
          "if": {
            "properties": { "routeProof": { "enum": ["declared_only", "none"] } },
            "required": ["routeProof"]
          },
          "then": { "properties": { "status": { "const": "unverified" } } }
        }
      ]
    },
    "autoscaler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hpa", "vpa"],
      "properties": {
        "hpa": { "$ref": "defs.schema.json#/$defs/autoscalerController" },
        "vpa": { "$ref": "defs.schema.json#/$defs/autoscalerController" }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "termination",
        "requests",
        "httpErrors",
        "actualRps",
        "httpErrorRate",
        "latency",
        "usefulThroughputRps",
        "droppedIterations",
        "generatorSaturated",
        "interval"
      ],
      "properties": {
        "executed": { "type": "boolean" },
        "termination": {
          "enum": [
            "duration_elapsed",
            "context_canceled",
            "context_deadline_exceeded",
            "invalid_configuration",
            "invalid_target",
            "internal_error",
            "not_started",
            "control_channel_lost"
          ]
        },
        "requests": { "type": "integer", "minimum": 0 },
        "httpErrors": { "type": "integer", "minimum": 0 },
        "actualRps": { "oneOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
        "httpErrorRate": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "defs.schema.json#/$defs/errorRate" }
          ]
        },
        "latency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantics", "p50Ns", "p95Ns", "p99Ns"],
          "properties": {
            "semantics": { "$ref": "defs.schema.json#/$defs/latencySemantics" },
            "p50Ns": { "$ref": "defs.schema.json#/$defs/durationSignal" },
            "p95Ns": { "$ref": "defs.schema.json#/$defs/durationSignal" },
            "p99Ns": { "$ref": "defs.schema.json#/$defs/durationSignal" }
          }
        },
        "usefulThroughputRps": {
          "description": "Null means not reported. A number is a measurement, including zero. unknown is a separate state.",
          "oneOf": [
            { "type": "null" },
            { "type": "number", "minimum": 0 },
            { "$ref": "defs.schema.json#/$defs/unknownSignal" }
          ]
        },
        "droppedIterations": {
          "description": "Null means the adapter did not report dropped work. Zero would claim no work was dropped. unknown is not zero.",
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 },
            { "$ref": "defs.schema.json#/$defs/unknownSignal" }
          ]
        },
        "generatorSaturated": {
          "description": "Null means saturation was not reported. false is a measured false. unknown is not false.",
          "oneOf": [
            { "type": "null" },
            { "type": "boolean" },
            { "$ref": "defs.schema.json#/$defs/unknownSignal" }
          ]
        },
        "checks": { "$ref": "defs.schema.json#/$defs/loadChecks" },
        "contractVersion": { "const": "1" },
        "adapter": { "$ref": "defs.schema.json#/$defs/componentIdentity" },
        "engine": { "$ref": "defs.schema.json#/$defs/componentIdentity" },
        "phases": {
          "description": "Actual phase bounds. Warmup and cooldown are outside measured statistics. When this array is present on duration_elapsed, it is one completed order with exactly one measured phase: measured; warmup then measured; measured then cooldown; or warmup, measured, then cooldown. A failed or cancelled run may instead record the prefix that actually started, including warmup alone, and must not invent a measured phase. Omitting the field leaves older documents valid. An empty array is allowed only when the load did not start.",
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "defs.schema.json#/$defs/actualPhase" }
        },
        "interval": {
          "description": "Collector-local start and finish. This is not a Metrics API source window.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["startedAt", "finishedAt", "clock"],
              "properties": {
                "startedAt": { "$ref": "defs.schema.json#/$defs/dateTime" },
                "finishedAt": { "$ref": "defs.schema.json#/$defs/dateTime" },
                "clock": {
                  "description": "collector_local is the in-process clock. runner is not renamed to collector_local. A non-collector clock requires experiment.clockMapping.",
                  "enum": ["collector_local", "runner", "source", "unknown"]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "requests": { "const": 0 } },
            "required": ["requests"]
          },
          "then": {
            "properties": {
              "actualRps": { "type": "null" },
              "httpErrorRate": { "type": "null" },
              "usefulThroughputRps": { "type": "null" },
              "latency": {
                "properties": {
                  "p50Ns": { "properties": { "state": { "const": "missing_signal" } } },
                  "p95Ns": { "properties": { "state": { "const": "missing_signal" } } },
                  "p99Ns": { "properties": { "state": { "const": "missing_signal" } } }
                }
              }
            }
          }
        },
        {
          "description": "Positive requests keep the observed rates. Known latency semantics still require known percentiles. Unknown semantics is exempt here because that branch requires missing_signal percentiles instead of invented numbers.",
          "if": {
            "properties": { "requests": { "exclusiveMinimum": 0 } },
            "required": ["requests"]
          },
          "then": {
            "properties": {
              "actualRps": { "type": "number" },
              "httpErrorRate": { "type": "number" }
            },
            "allOf": [
              {
                "if": {
                  "not": {
                    "properties": {
                      "latency": {
                        "properties": { "semantics": { "const": "unknown" } },
                        "required": ["semantics"]
                      }
                    },
                    "required": ["latency"]
                  }
                },
                "then": {
                  "properties": {
                    "latency": {
                      "properties": {
                        "p50Ns": { "properties": { "state": { "const": "known" } }, "required": ["state", "nanoseconds"] },
                        "p95Ns": { "properties": { "state": { "const": "known" } }, "required": ["state", "nanoseconds"] },
                        "p99Ns": { "properties": { "state": { "const": "known" } }, "required": ["state", "nanoseconds"] }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "executed": { "const": false } },
            "required": ["executed"]
          },
          "then": {
            "properties": {
              "termination": { "enum": ["not_started", "context_canceled", "invalid_configuration", "invalid_target"] },
              "requests": { "const": 0 },
              "httpErrors": { "const": 0 },
              "interval": { "type": "null" },
              "phases": { "maxItems": 0 }
            }
          }
        },
        {
          "description": "Unknown semantics does not publish known percentiles, including when requests are positive. The gap stays missing_signal rather than zero or a known semantics value.",
          "if": {
            "properties": {
              "latency": {
                "properties": { "semantics": { "const": "unknown" } },
                "required": ["semantics"]
              }
            },
            "required": ["latency"]
          },
          "then": {
            "properties": {
              "latency": {
                "properties": {
                  "p50Ns": { "properties": { "state": { "const": "missing_signal" } } },
                  "p95Ns": { "properties": { "state": { "const": "missing_signal" } } },
                  "p99Ns": { "properties": { "state": { "const": "missing_signal" } } }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "phases": { "minItems": 1 } },
            "required": ["phases"]
          },
          "then": {
            "properties": {
              "phases": {
                "oneOf": [
                  {
                    "prefixItems": [
                      { "properties": { "name": { "const": "measured" } }, "required": ["name"] }
                    ],
                    "maxItems": 1,
                    "minItems": 1
                  },
                  {
                    "prefixItems": [
                      { "properties": { "name": { "const": "warmup" } }, "required": ["name"] },
                      { "properties": { "name": { "const": "measured" } }, "required": ["name"] }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "prefixItems": [
                      { "properties": { "name": { "const": "measured" } }, "required": ["name"] },
                      { "properties": { "name": { "const": "cooldown" } }, "required": ["name"] }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  {
                    "prefixItems": [
                      { "properties": { "name": { "const": "warmup" } }, "required": ["name"] },
                      { "properties": { "name": { "const": "measured" } }, "required": ["name"] },
                      { "properties": { "name": { "const": "cooldown" } }, "required": ["name"] }
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  },
                  {
                    "prefixItems": [
                      { "properties": { "name": { "const": "warmup" } }, "required": ["name"] }
                    ],
                    "minItems": 1,
                    "maxItems": 1
                  }
                ]
              }
            }
          }
        },
        {
          "description": "duration_elapsed with actual phases still needs the one measured phase. A warmup-only prefix is not a successful measurement.",
          "if": {
            "properties": {
              "termination": { "const": "duration_elapsed" },
              "phases": { "minItems": 1 }
            },
            "required": ["termination", "phases"]
          },
          "then": {
            "properties": {
              "phases": {
                "contains": {
                  "properties": { "name": { "const": "measured" } },
                  "required": ["name"]
                }
              }
            }
          }
        },
        {
          "description": "Warmup alone is the prefix of a failed or cancelled run whose measured phase did not start. The interval stays null.",
          "if": {
            "properties": {
              "phases": {
                "minItems": 1,
                "maxItems": 1,
                "prefixItems": [
                  { "properties": { "name": { "const": "warmup" } }, "required": ["name"] }
                ]
              }
            },
            "required": ["phases"]
          },
          "then": {
            "properties": {
              "termination": {
                "enum": [
                  "context_canceled",
                  "context_deadline_exceeded",
                  "invalid_configuration",
                  "invalid_target",
                  "internal_error"
                ]
              },
              "interval": { "type": "null" }
            }
          }
        }
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceTimestamp",
          "windowNs",
          "polledAt",
          "disposition",
          "discardReason",
          "cpuMilliMax",
          "memoryBytesMax",
          "replayInputs",
          "replicas"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceTimestamp": { "$ref": "defs.schema.json#/$defs/dateTime" },
          "windowNs": { "type": "integer", "exclusiveMinimum": 0 },
          "polledAt": {
            "description": "Local poll time. Independent evidence uses sourceTimestamp and windowNs, not polledAt.",
            "$ref": "defs.schema.json#/$defs/dateTime"
          },
          "disposition": { "enum": ["accepted", "discarded"] },
          "discardReason": {
            "oneOf": [
              { "type": "null" },
              {
                "enum": [
                  "duplicate_poll",
                  "overlapping_window",
                  "outside_measured_interval",
                  "missing_pod",
                  "identity_changed",
                  "container_restart",
                  "conflicting_snapshot",
                  "foreign_pod",
                  "foreign_container",
                  "runner_metrics",
                  "aggregate_only",
                  "missing_target_coverage",
                  "metrics_uid_unlinked",
                  "mixed_replicas",
                  "clock_mapping_unknown",
                  "clock_uncertainty_boundary"
                ]
              }
            ]
          },
          "cpuMilliMax": { "$ref": "defs.schema.json#/$defs/cpuMilli" },
          "memoryBytesMax": { "$ref": "defs.schema.json#/$defs/memoryBytes" },
          "replayInputs": {
            "description": "Float inputs consumed by recommender-core-1. cpuCores is cores, memoryMi is mebibytes. They are not a second canonical unit.",
            "type": "object",
            "additionalProperties": false,
            "required": ["cpuCores", "memoryMi"],
            "properties": {
              "cpuCores": { "type": "number", "minimum": 0 },
              "memoryMi": { "type": "number", "minimum": 0 }
            }
          },
          "replicas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["podUid", "cpuMilli", "memoryBytes"],
              "properties": {
                "podUid": { "$ref": "defs.schema.json#/$defs/uuid" },
                "cpuMilli": { "$ref": "defs.schema.json#/$defs/cpuMilli" },
                "memoryBytes": { "$ref": "defs.schema.json#/$defs/memoryBytes" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "disposition": { "const": "accepted" } },
              "required": ["disposition"]
            },
            "then": { "properties": { "discardReason": { "type": "null" } } }
          },
          {
            "if": {
              "properties": { "disposition": { "const": "discarded" } },
              "required": ["disposition"]
            },
            "then": { "properties": { "discardReason": { "type": "string" } } }
          }
        ]
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedPodUids", "podsWithMetrics", "complete", "independentWindowCount", "discardedWindowCount"],
      "properties": {
        "expectedPodUids": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/uuid" }
        },
        "podsWithMetrics": {
          "type": "array",
          "items": { "$ref": "defs.schema.json#/$defs/uuid" }
        },
        "complete": { "type": "boolean" },
        "independentWindowCount": { "type": "integer", "minimum": 0 },
        "discardedWindowCount": { "type": "integer", "minimum": 0 }
      }
    },
    "experiment": { "$ref": "defs.schema.json#/$defs/directExperiment" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "workload": {
            "properties": {
              "discovery": { "const": "read" },
              "stability": {
                "anyOf": [
                  { "properties": { "deploymentUid": { "const": "changed" } }, "required": ["deploymentUid"] },
                  { "properties": { "generation": { "const": "changed" } }, "required": ["generation"] },
                  { "properties": { "imageDigest": { "const": "changed" } }, "required": ["imageDigest"] },
                  { "properties": { "containerRestarted": { "const": true } }, "required": ["containerRestarted"] },
                  { "properties": { "replicasFixed": { "const": false } }, "required": ["replicasFixed"] }
                ]
              }
            },
            "required": ["discovery", "stability"]
          }
        },
        "required": ["workload"]
      },
      "then": { "properties": { "identityStable": { "const": false } } }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "properties": {
              "discovery": { "const": "read" },
              "stability": {
                "properties": {
                  "deploymentUid": { "const": "unchanged" },
                  "generation": { "const": "unchanged" },
                  "imageDigest": { "const": "unchanged" },
                  "containerRestarted": { "const": false },
                  "replicasFixed": { "const": true }
                },
                "required": ["deploymentUid", "generation", "imageDigest", "containerRestarted", "replicasFixed"]
              }
            },
            "required": ["discovery", "stability"]
          }
        },
        "required": ["workload"]
      },
      "then": { "properties": { "identityStable": { "const": true } } }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "properties": { "discovery": { "const": "read" } },
            "required": ["discovery"]
          }
        },
        "required": ["workload"]
      },
      "then": {
        "properties": {
          "ownerChain": { "minItems": 1 },
          "pods": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "properties": { "discovery": { "const": "not_obtained" } },
            "required": ["discovery"]
          }
        },
        "required": ["workload"]
      },
      "then": {
        "properties": {
          "identityStable": { "const": false },
          "ownerChain": { "maxItems": 0 },
          "pods": { "maxItems": 0 },
          "windows": { "maxItems": 0 },
          "serviceMapping": {
            "properties": {
              "status": { "const": "unverified" },
              "routeProof": { "const": "none" }
            }
          },
          "coverage": {
            "properties": {
              "expectedPodUids": { "maxItems": 0 },
              "podsWithMetrics": { "maxItems": 0 },
              "complete": { "const": false },
              "independentWindowCount": { "const": 0 },
              "discardedWindowCount": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workload": {
            "properties": { "discovery": { "const": "partial" } },
            "required": ["discovery"]
          }
        },
        "required": ["workload"]
      },
      "then": {
        "properties": {
          "identityStable": { "const": false },
          "ownerChain": { "maxItems": 0 },
          "pods": { "maxItems": 0 },
          "windows": { "maxItems": 0 },
          "serviceMapping": {
            "properties": {
              "status": { "const": "unverified" },
              "routeProof": { "const": "none" }
            }
          },
          "coverage": {
            "properties": {
              "expectedPodUids": { "maxItems": 0 },
              "podsWithMetrics": { "maxItems": 0 },
              "complete": { "const": false },
              "independentWindowCount": { "const": 0 },
              "discardedWindowCount": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "required": ["experiment"],
          "properties": {
            "experiment": {
              "properties": {
                "observed": {
                  "properties": { "routeMode": { "const": "direct_pod" } },
                  "required": ["routeMode"]
                }
              },
              "required": ["observed"]
            }
          }
        }
      },
      "then": {
        "properties": {
          "serviceMapping": { "required": ["serviceName"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "experiment": {
            "properties": {
              "observed": {
                "properties": {
                  "routeMode": { "const": "direct_pod" },
                  "routeStatus": { "const": "verified" }
                },
                "required": ["routeMode", "routeStatus"]
              }
            },
            "required": ["observed"]
          }
        },
        "required": ["experiment"]
      },
      "then": {
        "properties": {
          "serviceMapping": {
            "properties": {
              "status": { "const": "unverified" },
              "routeProof": { "const": "none" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "load": {
            "properties": {
              "phases": {
                "contains": {
                  "type": "object",
                  "properties": { "clock": { "enum": ["runner", "source", "unknown"] } },
                  "required": ["clock"]
                }
              }
            },
            "required": ["phases"]
          }
        },
        "required": ["load"]
      },
      "then": {
        "required": ["experiment"],
        "properties": {
          "experiment": { "required": ["clockMapping"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "load": {
            "properties": {
              "interval": {
                "type": "object",
                "properties": { "clock": { "enum": ["runner", "source", "unknown"] } },
                "required": ["clock"]
              }
            },
            "required": ["interval"]
          }
        },
        "required": ["load"]
      },
      "then": {
        "required": ["experiment"],
        "properties": {
          "experiment": { "required": ["clockMapping"] }
        }
      }
    }
  ],
  "$defs": {
    "workloadRead": {
      "description": "Completed discovery. The Deployment was read and the pod census returned at least one pod. Stability is within this run. A different Deployment UID on another run is allowed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "namespace",
        "name",
        "container",
        "deploymentUid",
        "deploymentGeneration",
        "podSelector",
        "replicas",
        "image",
        "stability"
      ],
      "properties": {
        "discovery": { "const": "read" },
        "namespace": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "name": { "$ref": "defs.schema.json#/$defs/k8sSubdomain" },
        "container": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "deploymentUid": { "$ref": "defs.schema.json#/$defs/uuid" },
        "deploymentGeneration": { "type": "integer", "minimum": 1 },
        "podSelector": { "type": "string", "minLength": 1 },
        "replicas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["desired", "observed"],
          "properties": {
            "desired": { "type": "integer", "minimum": 1 },
            "observed": { "type": "integer", "minimum": 0 }
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "defs.schema.json#/$defs/imageDigest" }
          }
        },
        "stability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deploymentUid", "generation", "imageDigest", "containerRestarted", "replicasFixed"],
          "properties": {
            "deploymentUid": { "enum": ["unchanged", "changed"] },
            "generation": { "enum": ["unchanged", "changed"] },
            "imageDigest": { "enum": ["unchanged", "changed"] },
            "containerRestarted": { "type": "boolean" },
            "replicasFixed": { "type": "boolean" }
          }
        }
      }
    },
    "workloadPartial": {
      "description": "Deployment identity after a successful read whose pod census is not a completed discovery. UID, generation, selector, and replica counts come from that Deployment object. An image digest is stored only when one was read. Pod UIDs, owner UIDs, and stability are not stored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovery",
        "namespace",
        "name",
        "container",
        "deploymentUid",
        "deploymentGeneration",
        "podSelector",
        "replicas",
        "image",
        "podList"
      ],
      "properties": {
        "discovery": { "const": "partial" },
        "namespace": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "name": { "$ref": "defs.schema.json#/$defs/k8sSubdomain" },
        "container": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "deploymentUid": { "$ref": "defs.schema.json#/$defs/uuid" },
        "deploymentGeneration": {
          "description": "metadata.generation from the Deployment read. Generation starts at 1. Zero is not an unread generation.",
          "type": "integer",
          "minimum": 1
        },
        "podSelector": { "type": "string", "minLength": 1 },
        "replicas": {
          "description": "Counts from the Deployment object. desired is spec.replicas. observed is status.replicas. Zero is that spec or status value. It is not a substitute for a pod list that was not returned.",
          "type": "object",
          "additionalProperties": false,
          "required": ["desired", "observed"],
          "properties": {
            "desired": { "type": "integer", "minimum": 0 },
            "observed": { "type": "integer", "minimum": 0 }
          }
        },
        "image": {
          "description": "reference is the container image on the Deployment template. digest is known only when the read included an OCI digest. unknown has no value. A tag is not a digest.",
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "digest"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "digest": { "$ref": "#/$defs/imageDigestSignal" }
          }
        },
        "podList": {
          "description": "Pod census after the Deployment read. empty means ListPods succeeded and returned no pods. not_obtained means the list was not returned. A non-empty pod list is workload discovery read, not partial.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["discovery"],
              "properties": {
                "discovery": { "const": "empty" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["discovery", "unreadReason"],
              "properties": {
                "discovery": { "const": "not_obtained" },
                "unreadReason": {
                  "description": "list_failed is an error from ListPods. cancelled_before_pods is a cancellation after the Deployment read and before that list returned. cancelled_before_discovery is not used here, because the Deployment was already read.",
                  "enum": ["list_failed", "cancelled_before_pods"]
                }
              }
            }
          ]
        }
      }
    },
    "imageDigestSignal": {
      "description": "known carries the OCI digest that was read. unknown means the Deployment read did not include a digest. Unknown is not an empty string, a tag, or a fabricated sha256.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "unknown" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "known" },
            "value": { "$ref": "defs.schema.json#/$defs/imageDigest" }
          }
        }
      ]
    },
    "workloadUnread": {
      "description": "Names the run asked to read. namespace, name, and container are the request, not observed identity. No UID, generation, digest, selector, or stability is stored, and zero is not used as a stand-in.",
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery", "unreadReason", "namespace", "name", "container"],
      "properties": {
        "discovery": { "const": "not_obtained" },
        "unreadReason": {
          "description": "Closed reason the Deployment object was not obtained. forbidden and not_found are Kubernetes status responses. cancelled_before_discovery is caller cancellation before that read. timeout is a client deadline. transport_error is a request that received no Kubernetes status, such as connection refused. api_server_5xx is an API server 5xx response, including 503. The value is not a free-form message.",
          "enum": ["forbidden", "not_found", "cancelled_before_discovery", "timeout", "transport_error", "api_server_5xx"]
        },
        "namespace": { "$ref": "defs.schema.json#/$defs/k8sLabel" },
        "name": { "$ref": "defs.schema.json#/$defs/k8sSubdomain" },
        "container": { "$ref": "defs.schema.json#/$defs/k8sLabel" }
      }
    }
  }
}
