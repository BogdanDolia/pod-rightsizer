{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "T14 request shape. runtime_change is intentionally not an intent.",
  "title": "ComparisonRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "dataClass",
    "comparisonId",
    "intent",
    "baseline",
    "candidate"
  ],
  "properties": {
    "schemaVersion": { "$ref": "defs.schema.json#/$defs/schemaVersion" },
    "kind": { "const": "ComparisonRequest" },
    "dataClass": { "$ref": "defs.schema.json#/$defs/dataClass" },
    "comparisonId": { "$ref": "defs.schema.json#/$defs/uuid" },
    "intent": { "enum": ["code_regression", "resource_candidate"] },
    "baseline": { "$ref": "#/$defs/runRef" },
    "candidate": { "$ref": "#/$defs/runRef" },
    "declaredResourceChanges": {
      "description": "Required for resource_candidate and forbidden for code_regression. Only request and limit fields may be listed.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["cpuRequest", "cpuLimit", "memoryRequest", "memoryLimit"]
      }
    }
  },
  "$defs": {
    "runRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "manifestSha256"],
      "properties": {
        "runId": { "$ref": "defs.schema.json#/$defs/uuid" },
        "manifestSha256": { "$ref": "defs.schema.json#/$defs/sha256" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "intent": { "const": "resource_candidate" } },
        "required": ["intent"]
      },
      "then": { "required": ["declaredResourceChanges"] }
    },
    {
      "if": {
        "properties": { "intent": { "const": "code_regression" } },
        "required": ["intent"]
      },
      "then": { "not": { "required": ["declaredResourceChanges"] } }
    }
  ]
}
